analysis-engine/report.json

# Dependencies and env files, in case a tool runs from the root
node_modules/
.env
.env.*
!.env.example

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
